# Backend Production Environment Variables
# Add these to your Railway dashboard, not to a .env file

# Database Connection (from Neon)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Session Secret (generate with: openssl rand -base64 32)
SESSION_SECRET=your_secure_random_string_minimum_32_characters_long

# JWT Secret (REQUIRED - generate with: openssl rand -base64 48)
# This must be at least 32 characters long
# Application will NOT start without a valid JWT_SECRET
JWT_SECRET=your_secure_random_jwt_secret_minimum_48_characters_long_base64_encoded

# Environment
NODE_ENV=production

# Server Port (Railway sets this automatically, but default to 3001)
PORT=3001

# Frontend URL (from Vercel deployment)
FRONTEND_URL=https://your-app.vercel.app
