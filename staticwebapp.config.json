{
  "routes": [
    {
      "route": "/*",
      "allowedRoles": ["maintenance_lockdown"]
    }
  ],
  "responseOverrides": {
    "401": {
      "statusCode": 503,
      "rewrite": "/maintenance.html"
    },
    "403": {
      "statusCode": 503,
      "rewrite": "/maintenance.html"
    }
  },
  "platform": {
    "apiRuntime": "node:18"
  },
  "globalHeaders": {
    "Cache-Control": "no-store",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN"
  }
}
